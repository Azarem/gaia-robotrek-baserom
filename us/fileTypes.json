{
    "Bitmap": {
        "extension": "bin",
        "type": "Bitmap",
        "compressed": true
    },
    "RawBitmap": {
        "extension": "raw.bin",
        "type": "Bitmap"
    },
    "Tilemap": {
        "extension": "map",
        "header": 2,
        "type": "Tilemap",
        "compressed": true
    },
    "Tileset": {
        "extension": "set",
        "type": "Tileset",
        "compressed": true
    },
    "Spritemap": {
        "extension": "sprite.asm",
        "type": "Spritemap",
        "compressed": true,
        "struct": "~&sprite_set",
        "base": 0
    },
    "RawSpritemap": {
        "extension": "raw.sprite.asm",
        "type": "Spritemap",
        "struct": "~&sprite_set",
        "base": 0,
        "upper": true
    },
    "RawSpritemap2": {
        "extension": "raw.sprite2.asm",
        "type": "Spritemap",
        "struct": "~&sprite_set2",
        "base": 0,
        "upper": true
    },
    "Music": {
        "extension": "bgm",
        "type": "Music"
    },
    "Sound": {
        "extension": "sfx",
        "header": -2,
        "type": "Sound"
    },
    "Unknown": {
        "extension": "unk",
        "type": "Unknown"
    },
    "Patch": {
        "extension": "patch.asm",
        "type": "Patch",
        "isPatch": true
    },
    "Assembly": {
        "extension": "asm",
        "type": "Assembly",
        "isBlock": true
    },
    "Palette": {
        "extension": "pal",
        "type": "Palette"
    },
    "Binary": {
        "extension": "raw",
        "type": "Binary"
    }
}